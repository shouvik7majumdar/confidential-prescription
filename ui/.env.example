# Confidential Prescription Verification — Environment Configuration
# Copy this file to .env.local and fill in the values.

# Network: undeployed | preview | preprod
VITE_NETWORK=undeployed

# Contract address deployed via `npm run setup -- --network <NETWORK>`
# Get this from .midnight-state.json after deploy
VITE_CONTRACT_ADDRESS=

# Proof server URL (local docker by default)
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Indexer URL (auto-set by network, override if needed)
# VITE_INDEXER_URL=
# VITE_INDEXER_WS_URL=